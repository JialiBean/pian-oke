# API keys and endpoints used ONLY by the local dev server for PDF sheet-music
# transcription (BYOK — bring your own key). They never reach the browser, and
# nothing is called until you click "Transcribe" in the app.
#
# Setup: copy this file to .env, fill in what you have, restart `npm run dev`.
# Never commit .env. All entries are optional — configure only the providers
# you want to use.

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — https://platform.openai.com (note: API billing is separate from a
# ChatGPT Plus subscription; a subscription alone has no API access)
#OPENAI_API_KEY=

# OpenRouter — https://openrouter.ai (one key, many models)
#OPENROUTER_API_KEY=

# Google Gemini — https://aistudio.google.com
#GEMINI_API_KEY=

# Local models (free, offline) — no key needed, just have the server running:
#   Ollama:    default http://localhost:11434/v1  (e.g. `ollama pull qwen2.5vl:7b`)
#   LM Studio: default http://localhost:1234/v1
# Override the defaults only if you changed their ports:
#OLLAMA_BASE_URL=
#LMSTUDIO_BASE_URL=

# Any other OpenAI-compatible endpoint ("Custom endpoint" in the app):
#OPENAI_BASE_URL=

# Classic OMR: Audiveris is auto-detected at /Applications/Audiveris.app.
# Set this only for a non-standard install location:
#AUDIVERIS_PATH=
